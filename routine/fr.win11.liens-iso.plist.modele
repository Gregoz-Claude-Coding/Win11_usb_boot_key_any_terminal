<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>fr.win11.liens-iso</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PHP__</string>
        <string>__DOSSIER__/maj_lien.php</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__DOSSIER__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>__HEURE__</integer>
        <key>Minute</key>
        <integer>__MINUTE__</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__DOSSIER__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__DOSSIER__/launchd.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
